# Copy to .env and fill in. Never commit .env.

# LLM provider: google (Gemini, default) or openai
LLM_PROVIDER=google
GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional settings (defaults shown)
# LLM_MODEL=                      # default: gemini-3.5-flash (google) / gpt-5.5 (openai)
# LLM_TEMPERATURE=                # empty = model default
# LLM_MAX_TOKENS=2000
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# AGENT_MAX_TOOL_ROUNDS=6
# MAX_RESULT_ROWS=50
# QUERY_TIMEOUT_SECONDS=10
# LOG_DIR=logs

# Database: SQLite file built by `make db` (default), or MySQL
# DATABASE_URL=sqlite:///data/atliq_tshirts.db
# DATABASE_URL=mysql+pymysql://atliq_reader:change_me@localhost:3306/atliq_tshirts

# Streamlit -> API address
# TSHIRT_AGENT_API_URL=http://127.0.0.1:8000

# Optional LangSmith tracing of every agent step
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=atliq-tees-sql-agent
